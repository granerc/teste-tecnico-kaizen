PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura do JWT (minimo 32 caracteres). NAO existe valor padrao no
# codigo: sem isto o servidor nao sobe. Gere com: npm run segredo:gerar
JWT_SEGREDO=troque-por-um-segredo-aleatorio
JWT_EXPIRACAO=7d

# Banco proprio do e-commerce (usuarios, enderecos, carrinhos).
# Catalogo e pedidos NAO ficam aqui: vem do ERP.
DB_PATH=./data/ecommerce.db

# --- Integracao com o Kaizen ERP -------------------------------------------
# Tambem sem valor padrao no codigo: o token e segredo e nunca vai para o git.
ERP_URL=cole-aqui-a-URL-do-kaizen-erp
ERP_TOKEN=cole-aqui-o-API_TOKEN-do-kaizen-erp
ERP_TIMEOUT_MS=8000

# Origem(ns) do front permitidas no CORS, separadas por virgula.
# Em desenvolvimento o Vite faz proxy de /api (mesma origem) e CORS nem entra em
# jogo; em producao o backend serve o build do front. Qualquer outra origem e
# recusada.
CORS_ORIGEM=http://localhost:5173
