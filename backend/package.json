{
  "name": "kaizen-ecommerce-backend",
  "version": "1.0.0",
  "description": "BFF do e-commerce de autopecas - consome a API do Kaizen ERP",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "start": "node src/server.js",
